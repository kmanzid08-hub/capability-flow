# Local development defaults
DATABASE_URL=postgresql+psycopg://capability_flow:capability_flow@localhost:5432/capability_flow
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173"]

# Local filesystem is the default.
STORAGE_BACKEND=local
DOCUMENT_STORAGE_PATH=storage/documents

# Production / Cloudflare R2
# STORAGE_BACKEND=r2
# R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=your_access_key_id
# R2_SECRET_ACCESS_KEY=your_secret_access_key
# R2_BUCKET_NAME=capability-flow-files

# Claude stays optional until you add your key.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
